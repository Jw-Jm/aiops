[
  {
    "path": "/v1/sys/health",
    "status": 200,
    "initialized": true,
    "sealed": false,
    "version": "2.7.0"
  },
  {
    "path": "/v1/sys/policies/acl/ops-worker",
    "status": 200,
    "policy": "path \"transit/encrypt/evidence-archive\" { capabilities = [\"update\"] }\npath \"transit/decrypt/evidence-archive\" { capabilities = [\"update\"] }\npath \"transit/sign/audit-signing\" { capabilities = [\"update\"] }\npath \"transit/verify/audit-signing\" { capabilities = [\"update\"] }"
  },
  {
    "path": "/v1/auth/kubernetes/role/ops-worker",
    "status": 200,
    "bindings": {
      "audience": "openbao",
      "bound_service_account_names": [
        "ops-worker"
      ],
      "bound_service_account_namespaces": [
        "ops-system"
      ],
      "token_policies": [
        "ops-worker"
      ],
      "token_ttl": 900
    }
  },
  {
    "path": "/v1/auth/kubernetes/config",
    "status": 200,
    "config": {
      "kubernetes_host": "https://kubernetes.default.svc",
      "token_reviewer_jwt_set": false,
      "disable_iss_validation": true
    }
  },
  {
    "path": "/v1/transit/keys/evidence-archive",
    "status": 200,
    "key": {
      "name": "evidence-archive",
      "type": "aes256-gcm96",
      "latest_version": 1,
      "exportable": false,
      "allow_plaintext_backup": false
    }
  },
  {
    "path": "/v1/transit/keys/audit-signing",
    "status": 200,
    "key": {
      "name": "audit-signing",
      "type": "ed25519",
      "latest_version": 1,
      "exportable": false,
      "allow_plaintext_backup": false
    }
  },
  {
    "path": "/v1/sys/policies/acl/ops-api-workload",
    "status": 200,
    "policy": "path \"pki/sign/platform-workload-ops-api\" { capabilities = [\"update\"] }"
  },
  {
    "path": "/v1/auth/kubernetes/role/ops-api-workload",
    "status": 200,
    "bindings": {
      "audience": "openbao",
      "bound_service_account_names": [
        "ops-api"
      ],
      "bound_service_account_namespaces": [
        "ops-system"
      ],
      "token_policies": [
        "ops-api-workload"
      ],
      "token_ttl": 900
    }
  },
  {
    "path": "/v1/pki/roles/platform-workload-ops-api",
    "status": 200,
    "pki": {
      "allowed_uri_sans": [
        "spiffe://ops.local/ns/ops-system/sa/ops-api"
      ],
      "allowed_domains": [
        "ops-api.ops-system.svc.cluster.local"
      ],
      "ttl": 0,
      "max_ttl": 3600,
      "allow_any_name": false,
      "allow_subdomains": false,
      "require_cn": false
    }
  },
  {
    "path": "/v1/pki/roles/platform-workload-ops-worker",
    "status": 200,
    "pki": {
      "allowed_uri_sans": [
        "spiffe://ops.local/ns/ops-system/sa/ops-worker"
      ],
      "allowed_domains": [
        "ops-worker.ops-system.svc.cluster.local"
      ],
      "ttl": 0,
      "max_ttl": 3600,
      "allow_any_name": false,
      "allow_subdomains": false,
      "require_cn": false
    }
  }
]

