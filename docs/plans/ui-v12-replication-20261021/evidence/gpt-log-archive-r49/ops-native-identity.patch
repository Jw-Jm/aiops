 var tooLongLinesSkipped = metrics.GetOrCreateCounter("vl_too_long_lines_skipped_total")
 var rowsDroppedTotalTooManyFields = metrics.GetOrCreateCounter(`vl_rows_dropped_total{reason="too_many_fields"}`)
 var rowsDroppedTotalInvalidCRI = metrics.GetOrCreateCounter(`vl_rows_dropped_total{reason="invalid_cri_line"}`)
+
+// Keep native identity and CRI event time authoritative, and preserve the original message.
+func opsFields(fields []logstorage.Field, raw string) []logstorage.Field {
+	level := "unknown"
+	out := fields[:0]
+	for _, field := range fields {
+		if field.Name == "level" {
+			switch strings.ToLower(field.Value) {
+			case "error", "warn", "info", "debug":
+				level = strings.ToLower(field.Value)
+			case "warning":
+				level = "warn"
+			}
+			continue
+		}
+		if strings.HasPrefix(field.Name, "kubernetes.") || field.Name == "tenant" || field.Name == "cluster" || field.Name == "collector" || field.Name == "_msg" || field.Name == "_time" || field.Name == "_stream" || field.Name == "_stream_id" {
+			continue
+		}
+		out = append(out, field)
+	}
+	return append(out, logstorage.Field{Name: "_msg", Value: raw}, logstorage.Field{Name: "level", Value: level})
+}
