package openbao
import("context";"encoding/json";"os";"path/filepath";"strings";"testing")
func TestCodexReviewPendingSymlinkEscape(t *testing.T){
 fakeKubectl(t,"fail-before-send")
 ca,repo:=bootstrapPaths(t)
 victim:=filepath.Join(repo,"bootstrap-key.json")
 if err:=os.Symlink(victim,pendingMaterialPath(ca));err!=nil{t.Fatal(err)}
 err:=EnsureBootstrapTLS(context.Background(),"fixture","ops","openbao",ca,repo,"")
 if err==nil||!strings.Contains(err.Error(),"CREATE_UNKNOWN"){t.Fatalf("unexpected result: %v",err)}
 raw,e:=os.ReadFile(victim);if e!=nil{t.Fatal(e)}
 var m bootstrapPendingMaterial;if json.Unmarshal(raw,&m)!=nil||m.PrivateKey==""{t.Fatal("private key not reproduced")}
 t.Log("REPRODUCED: pending symlink wrote leaf private key into the protected temporary repository")
}
func TestCodexReviewExistingSecretKeyMismatch(t *testing.T){
 state:=fakeKubectl(t,"ok");ca,repo:=bootstrapPaths(t)
 if err:=EnsureBootstrapTLS(context.Background(),"fixture","ops","openbao",ca,repo,"");err!=nil{t.Fatal(err)}
 raw,err:=os.ReadFile(filepath.Join(state,"secret.json"));if err!=nil{t.Fatal(err)}
 var secret map[string]any;if err=json.Unmarshal(raw,&secret);err!=nil{t.Fatal(err)}
 secret["data"].(map[string]any)["tls.key"]="YW5vdGhlciBrZXk="
 raw,err=json.Marshal(secret);if err!=nil{t.Fatal(err)}
 if err=os.WriteFile(filepath.Join(state,"secret.json"),raw,0600);err!=nil{t.Fatal(err)}
 if err=EnsureBootstrapTLS(context.Background(),"fixture","ops","openbao",ca,repo,"");err!=nil{t.Fatalf("key mismatch was already rejected: %v",err)}
 t.Log("REPRODUCED: a valid certificate with a mismatched private key was accepted after pending cleanup")
}
