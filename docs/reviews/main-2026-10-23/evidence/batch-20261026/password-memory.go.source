package identity

import (
 "context"
 "errors"
 "os"
 "strconv"
 "strings"
 "sync"
 "sync/atomic"
 "testing"
)

func TestAcceptancePasswordRealMemory(t *testing.T) {
 hash,err:=HashPassword("acceptance-memory-password")
 if err!=nil{t.Fatal(err)}
 original:=passwordKDF
 var active,peak,busy,completed atomic.Int64
 passwordKDF=func(password,salt []byte,timeCost,memory uint32,threads uint8,keyLen uint32)[]byte{
  current:=active.Add(1)
  for old:=peak.Load();current>old&&!peak.CompareAndSwap(old,current);old=peak.Load(){}
  defer active.Add(-1)
  return original(password,salt,timeCost,memory,threads,keyLen)
 }
 defer func(){passwordKDF=original}()
 start:=make(chan struct{})
 var wg sync.WaitGroup
 for i:=range 128{
  wg.Add(1)
  go func(i int){defer wg.Done();<-start
   var err error
   if i%2==0{_,err=HashPasswordContext(context.Background(),"acceptance-memory-password")}else{var ok bool;ok,err=VerifyPasswordContext(context.Background(),"acceptance-memory-password",hash);if err==nil&&!ok{t.Error("correct password rejected")}}
   if errors.Is(err,ErrPasswordWorkBusy){busy.Add(1)}else if err!=nil{t.Error(err)}else{completed.Add(1)}
  }(i)
 }
 close(start);wg.Wait()
 raw,err:=os.ReadFile("/proc/self/status");if err!=nil{t.Fatal(err)}
 var rss int64
 for _,line:=range strings.Split(string(raw),"\n"){if strings.HasPrefix(line,"VmHWM:"){fields:=strings.Fields(line);rss,err=strconv.ParseInt(fields[1],10,64);if err!=nil{t.Fatal(err)}}}
 if peak.Load()!=passwordWorkLimit||busy.Load()==0||completed.Load()==0||rss<=0||rss>=512*1024{t.Fatalf("peak=%d busy=%d completed=%d highWaterRSSKiB=%d",peak.Load(),busy.Load(),completed.Load(),rss)}
 t.Logf("real Argon2id: concurrentKDF=%d busy=%d completed=%d highWaterRSSKiB=%d",peak.Load(),busy.Load(),completed.Load(),rss)
}
