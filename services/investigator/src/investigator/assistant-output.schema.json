{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "assistant-answer/v1"
    },
    "answerKind": {
      "enum": [
        "data",
        "diagnosis",
        "clarification",
        "unsupported"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "factRefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "queryResultId": {
            "type": "string",
            "format": "uuid"
          },
          "factId": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "queryResultId",
          "factId"
        ]
      }
    },
    "queryResultRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "entityRefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "degradedSources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "nextChecks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "scopeSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "partial": {
      "type": "boolean"
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "supports": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "missingEvidence": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "nextChecks": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "required": [
          "key",
          "summary",
          "supports",
          "conflicts",
          "missingEvidence",
          "nextChecks"
        ]
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clarificationId": {
              "type": "string",
              "format": "uuid"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "missingFields": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "candidates": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "required": [
            "clarificationId",
            "question",
            "missingFields",
            "candidates"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "answerKind",
    "summary",
    "factRefs",
    "queryResultRefs",
    "evidenceRefs",
    "entityRefs",
    "missingEvidence",
    "degradedSources",
    "warnings",
    "nextChecks",
    "scopeSummary",
    "asOf",
    "partial",
    "hypotheses",
    "clarification"
  ]
}
