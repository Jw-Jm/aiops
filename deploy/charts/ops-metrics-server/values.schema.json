{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "servingTLSSecret",
    "servingCA",
    "kubeletCAConfigMap",
    "nodeCIDRs",
    "apiServerCIDRs",
    "apiServerPort",
    "networkPolicyOnly",
    "architecture"
  ],
  "properties": {
    "image": {
      "type": "string",
      "enum": [
        "registry.k8s.io/metrics-server/metrics-server@sha256:8f49cf1b0688bb0eae18437882dbf6de2c7a2baac71b1492bc4eca25439a1bf2",
        "registry.k8s.io/metrics-server/metrics-server@sha256:89258156d0e9af60403eafd44da9676fd66f600c7934d468ccc17e42b199aee2"
      ]
    },
    "servingTLSSecret": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "servingCA": {
      "type": "string",
      "minLength": 64
    },
    "kubeletCAConfigMap": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "nodeCIDRs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([0-9.]+/32|[0-9a-fA-F:]+/128)$"
      }
    },
    "apiServerCIDRs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([0-9.]+/32|[0-9a-fA-F:]+/128)$"
      }
    },
    "apiServerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "networkPolicyOnly": {
      "type": "boolean"
    },
    "architecture": {
      "type": "string",
      "enum": [
        "arm64",
        "amd64"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "architecture": {
            "const": "amd64"
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "const": "registry.k8s.io/metrics-server/metrics-server@sha256:89258156d0e9af60403eafd44da9676fd66f600c7934d468ccc17e42b199aee2"
          }
        }
      },
      "else": {
        "properties": {
          "image": {
            "enum": [
              "registry.k8s.io/metrics-server/metrics-server@sha256:8f49cf1b0688bb0eae18437882dbf6de2c7a2baac71b1492bc4eca25439a1bf2"
            ]
          }
        }
      }
    }
  ]
}
