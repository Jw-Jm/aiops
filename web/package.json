{
  "name": "ops-platform-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.7.0"
  },
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "test": "node --experimental-strip-types --test ./test/*.test.mjs && vitest run",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test:contract": "node --experimental-strip-types --test ./test/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cytoscape": "3.31.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "orval": "8.37.0",
    "prettier": "3.7.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@tanstack/react-query": "5.104.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.5",
    "cytoscape": "3.34.3",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  }
}
