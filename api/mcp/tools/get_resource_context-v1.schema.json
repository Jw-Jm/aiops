{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/get_resource_context/v1",
  "title": "get_resource_context",
  "description": "Return a bounded resource context, selected relations, health, freshness, source references, and related findings.",
  "type": "object",
  "properties": {
    "canonicalId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "canonicalId",
    "depth"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_resource_context"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "entity": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/entity"
            },
            "health": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/health"
            },
            "selectedRelations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "canonicalId": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
                  },
                  "kind": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "sourceType": {
                        "enum": [
                          "explicit_ref",
                          "owner_reference",
                          "selector_match",
                          "binding_resolution",
                          "identity_join",
                          "inference_rule",
                          "runtime_observed"
                        ]
                      },
                      "state": {
                        "enum": [
                          "asserted",
                          "observed",
                          "inferred"
                        ]
                      },
                      "resolver": {
                        "anyOf": [
                          {
                            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "extensions": {
                        "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                      }
                    },
                    "required": [
                      "sourceType",
                      "state",
                      "resolver"
                    ],
                    "additionalProperties": false
                  },
                  "freshness": {
                    "anyOf": [
                      {
                        "$ref": "https://ops.local/schemas/common/v1#/$defs/timestamp"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "extensions": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                  }
                },
                "required": [
                  "canonicalId",
                  "kind",
                  "provenance",
                  "freshness"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            },
            "sourceRefs": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
              },
              "maxItems": 1000
            },
            "freshness": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/freshness"
            },
            "relatedFindings": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/finding-envelope/v1"
              },
              "maxItems": 1000
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "entity",
            "health",
            "selectedRelations",
            "sourceRefs",
            "freshness",
            "relatedFindings"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "get_resource_context",
    "version": "v1",
    "purpose": "Return a bounded resource context, selected relations, health, freshness, source references, and related findings.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/get_resource_context/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/get_resource_context/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "namespace_scope"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxToolCalls"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
