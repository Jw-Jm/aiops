{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/get_evidence_conflicts/v1",
  "title": "get_evidence_conflicts",
  "description": "Return unresolved evidence conflicts for the authorized incident.",
  "type": "object",
  "properties": {
    "incidentId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "incidentId"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_evidence_conflicts"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "conflictId": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                  },
                  "code": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                  },
                  "summary": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/text"
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                    },
                    "maxItems": 1000
                  },
                  "severity": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/severity"
                  },
                  "resolution": {
                    "anyOf": [
                      {
                        "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "extensions": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                  }
                },
                "required": [
                  "conflictId",
                  "code",
                  "summary",
                  "evidenceRefs",
                  "severity",
                  "resolution"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "get_evidence_conflicts",
    "version": "v1",
    "purpose": "Return unresolved evidence conflicts for the authorized incident.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/get_evidence_conflicts/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/get_evidence_conflicts/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "allowed_data_classes"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxToolCalls"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
