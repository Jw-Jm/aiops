{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/query_logs/v2",
  "title": "query_logs",
  "description": "Query VictoriaLogs using a bounded, server-side template with sensitive-data redaction.",
  "type": "object",
  "properties": {
    "resourceCanonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-z][a-z0-9.-]{0,62}\\+v1://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+$"
    },
    "type": {
      "const": "log"
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "queryTemplate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$"
    },
    "budget": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "timeoutMs",
        "maxBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resourceCanonicalId",
    "type",
    "timeRange",
    "queryTemplate",
    "budget"
  ],
  "additionalProperties": false,
  "x-tool-contract": {
    "name": "query_logs",
    "version": "v2",
    "purpose": "Query VictoriaLogs using a bounded, server-side template with sensitive-data redaction.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/query_logs/v2"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/query_logs/v2#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "namespace_scope",
      "allowed_data_classes"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": 3,
    "maxResultBytes": 65536,
    "rateLimit": {
      "jobBudget": "maxRawQueries"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  },
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "allOf": [
        {
          "$ref": "https://ops.local/schemas/tool-response/v2"
        },
        {
          "properties": {
            "tool": {
              "const": "query_logs"
            }
          }
        }
      ]
    }
  }
}
