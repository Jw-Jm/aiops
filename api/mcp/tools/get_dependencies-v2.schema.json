{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/get_dependencies/v2",
  "title": "get_dependencies",
  "description": "Return bounded upstream and downstream resource relations with provenance and freshness.",
  "type": "object",
  "properties": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-z][a-z0-9.-]{0,62}\\+v1://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})+$"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    }
  },
  "required": [
    "canonicalId",
    "depth"
  ],
  "additionalProperties": false,
  "x-tool-contract": {
    "name": "get_dependencies",
    "version": "v2",
    "purpose": "Return bounded upstream and downstream resource relations with provenance and freshness.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/get_dependencies/v2"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/get_dependencies/v2#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "namespace_scope"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": 3,
    "maxResultBytes": 65536,
    "rateLimit": {
      "jobBudget": "maxToolCalls"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  },
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "allOf": [
        {
          "$ref": "https://ops.local/schemas/tool-response/v2"
        },
        {
          "properties": {
            "tool": {
              "const": "get_dependencies"
            }
          }
        }
      ]
    }
  }
}
