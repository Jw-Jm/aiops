{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/query_metrics/v1",
  "title": "query_metrics",
  "description": "Query VictoriaMetrics through a bounded server-side query template.",
  "type": "object",
  "properties": {
    "resourceCanonicalId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "type": {
      "const": "metric"
    },
    "timeRange": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/timeRange"
    },
    "queryTemplate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$"
    },
    "budget": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "timeoutMs",
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "resourceCanonicalId",
    "type",
    "timeRange",
    "queryTemplate",
    "budget"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "query_metrics"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/evidence/v1"
              },
              "maxItems": 1000
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "query_metrics",
    "version": "v1",
    "purpose": "Query VictoriaMetrics through a bounded server-side query template.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/query_metrics/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/query_metrics/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "allowed_data_classes"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxRawQueries"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
