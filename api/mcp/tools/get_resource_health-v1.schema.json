{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/get_resource_health/v1",
  "title": "get_resource_health",
  "description": "Return deterministic resource health, findings, and data-integrity state.",
  "type": "object",
  "properties": {
    "canonicalId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "canonicalId"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_resource_health"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "health": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/health"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/finding-envelope/v1"
              },
              "maxItems": 1000
            },
            "dataIntegrity": {
              "type": "object",
              "properties": {
                "partial": {
                  "type": "boolean"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
                  },
                  "maxItems": 1000
                },
                "extensions": {
                  "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                }
              },
              "required": [
                "partial",
                "warnings"
              ],
              "additionalProperties": false
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "health",
            "findings",
            "dataIntegrity"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "get_resource_health",
    "version": "v1",
    "purpose": "Return deterministic resource health, findings, and data-integrity state.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/get_resource_health/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/get_resource_health/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "namespace_scope"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxToolCalls"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
