{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/query_kubernetes/v1",
  "title": "query_kubernetes",
  "description": "Read allowlisted Kubernetes resources and fields within the authorized cluster and namespace scope.",
  "type": "object",
  "properties": {
    "canonicalId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "canonicalId"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "query_kubernetes"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resourceCanonicalId": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
                  },
                  "kind": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
                  },
                  "observedAt": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/timestamp"
                  },
                  "state": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                  },
                  "extensions": {
                    "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
                  }
                },
                "required": [
                  "resourceCanonicalId",
                  "kind",
                  "observedAt",
                  "state"
                ],
                "additionalProperties": false
              },
              "maxItems": 1000
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "query_kubernetes",
    "version": "v1",
    "purpose": "Read allowlisted Kubernetes resources and fields within the authorized cluster and namespace scope.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/query_kubernetes/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/query_kubernetes/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope",
      "cluster_scope",
      "namespace_scope",
      "allowed_data_classes"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxRawQueries"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
