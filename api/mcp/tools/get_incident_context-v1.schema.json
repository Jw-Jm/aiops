{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/get_incident_context/v1",
  "title": "get_incident_context",
  "description": "Return the authorized incident, related findings, resources, current RCA, and degraded sources.",
  "type": "object",
  "properties": {
    "incidentId": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
    },
    "extensions": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
    }
  },
  "required": [
    "incidentId"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "$anchor": "output",
      "type": "object",
      "properties": {
        "tool": {
          "const": "get_incident_context"
        },
        "state": {
          "const": "succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "incident": {
              "$ref": "https://ops.local/schemas/incident/v1"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/finding-envelope/v1"
              },
              "maxItems": 1000
            },
            "primaryResource": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
            },
            "affectedResources": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
              },
              "maxItems": 1000
            },
            "currentRca": {
              "anyOf": [
                {
                  "$ref": "https://ops.local/schemas/rca-result/v1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "degradedSources": {
              "type": "array",
              "items": {
                "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
              },
              "maxItems": 1000
            },
            "extensions": {
              "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
            }
          },
          "required": [
            "incident",
            "findings",
            "primaryResource",
            "affectedResources",
            "currentRca",
            "degradedSources"
          ],
          "additionalProperties": false
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/identifier"
          },
          "maxItems": 1000
        },
        "degradedSources": {
          "type": "array",
          "items": {
            "$ref": "https://ops.local/schemas/common/v1#/$defs/shortText"
          },
          "maxItems": 1000
        },
        "budget": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/resultBudget"
        },
        "extensions": {
          "$ref": "https://ops.local/schemas/common/v1#/$defs/extensions"
        }
      },
      "required": [
        "tool",
        "state",
        "data",
        "evidenceRefs",
        "degradedSources",
        "budget"
      ],
      "additionalProperties": false
    }
  },
  "x-tool-contract": {
    "name": "get_incident_context",
    "version": "v1",
    "purpose": "Return the authorized incident, related findings, resources, current RCA, and degraded sources.",
    "inputSchema": {
      "$ref": "https://ops.local/schemas/get_incident_context/v1"
    },
    "outputSchema": {
      "$ref": "https://ops.local/schemas/get_incident_context/v1#output"
    },
    "requiredPermissions": [
      "allowed_tools",
      "tenant_scope"
    ],
    "allowedDataClasses": [
      "D0",
      "D1"
    ],
    "defaultTimeout": {
      "jobBudget": "maxDuration"
    },
    "maxResultBytes": {
      "jobBudget": "maxResultBytes"
    },
    "rateLimit": {
      "jobBudget": "maxToolCalls"
    },
    "auditPolicy": "every_invocation_and_sanitized_result",
    "failureSemantics": [
      "invalid_arguments",
      "permission_denied",
      "data_class_denied",
      "budget_exhausted",
      "source_degraded",
      "timeout",
      "temporary_upstream_error",
      "job_cancelled"
    ]
  }
}
