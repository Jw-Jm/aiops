{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/investigation-step/v2",
  "title": "investigation-step/v2",
  "type": "object",
  "properties": {
    "stepId": {
      "type": "string",
      "format": "uuid"
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "argsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ]
    },
    "result": {},
    "errorCode": {
      "type": "string",
      "maxLength": 128
    },
    "argsSummary": {
      "type": "object",
      "description": "Bounded safe scope and budget projection; raw queries and model prompts are omitted. Historical steps may have an empty summary.",
      "maxProperties": 16,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 1024
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    }
  },
  "required": [
    "stepId",
    "toolName",
    "argsDigest",
    "state"
  ],
  "additionalProperties": false
}
