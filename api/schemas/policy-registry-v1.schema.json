{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/policy-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "modules"],
  "properties": {
    "schemaVersion": { "const": "policy-registry/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,199}$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}$" },
          "content": { "type": "string", "minLength": 1, "maxLength": 262144 }
        }
      }
    }
  }
}
