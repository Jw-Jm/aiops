{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/recipe-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "steps"],
  "properties": {
    "schemaVersion": { "const": "recipe-registry/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,199}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "toolName", "input"],
        "properties": {
          "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
          "input": { "type": "object" }
        }
      }
    }
  }
}
