{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/query-intent/v1",
  "title": "query-intent/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "query-intent/v1"
    },
    "datasetId": {
      "enum": [
        "resources.current",
        "findings.occurrences",
        "incidents.records",
        "executions.records",
        "audit.events",
        "metrics.pod-restarts",
        "metrics.pod-cpu",
        "metrics.pod-memory",
        "metrics.pod-phase",
        "metrics.node-ready",
        "logs.records",
        "incidents.recovery-duration",
        "executions.success-rate",
        "network.http-responses",
        "network.http-5xx",
        "network.http-5xx-rate",
        "network.http-response-time",
        "network.tcp-retransmissions",
        "network.connection-failure-observations",
        "network.http-summary",
        "network.tcp-summary"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 3,
      "minItems": 1,
      "uniqueItems": true
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 2,
      "minItems": 0,
      "uniqueItems": true
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ]
      },
      "maxItems": 8,
      "minItems": 0,
      "uniqueItems": true
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ]
      },
      "maxItems": 2,
      "minItems": 0,
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ]
    },
    "stepSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "comparisonTimeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ]
    },
    "networkSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetCanonicalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "peerCanonicalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "either"
          ]
        }
      },
      "required": [
        "targetCanonicalId",
        "peerCanonicalId",
        "direction"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "datasetId",
    "operation",
    "metrics",
    "dimensions",
    "filters",
    "sort",
    "limit"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "trend"
          }
        }
      },
      "then": {
        "required": [
          "timeRange",
          "stepSeconds"
        ]
      },
      "else": {
        "not": {
          "required": [
            "stepSeconds"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "compare",
              "compare_percent"
            ]
          }
        }
      },
      "then": {
        "required": [
          "timeRange",
          "comparisonTimeRange"
        ]
      },
      "else": {
        "not": {
          "required": [
            "comparisonTimeRange"
          ]
        }
      }
    }
  ]
}
