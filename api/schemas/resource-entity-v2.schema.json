  "required": [
    "canonicalId",
    "tenantId",
    "domain",
    "scope",
    "apiGroup",
    "kind",
    "stableId",
    "name",
    "namespace",
    "labels",
    "attributes",
    "sourceRefs",
    "firstObservedAt",
    "lastObservedAt"
