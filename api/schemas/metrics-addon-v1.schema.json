{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/metrics-addon/v1",
  "title": "Explicit Metrics-server addon installation inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "namespace", "servingTLSSecret", "servingCA", "kubeletCAConfigMap", "nodeCIDRs", "apiServerCIDRs", "apiServerPort"],
  "properties": {
    "schemaVersion": {"const": 1},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "servingTLSSecret": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "servingCA": {"type": "string", "minLength": 64, "maxLength": 65536},
    "kubeletCAConfigMap": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "nodeCIDRs": {"$ref": "#/$defs/addresses"},
    "apiServerCIDRs": {"$ref": "#/$defs/addresses"},
    "apiServerPort": {"type": "integer", "minimum": 1, "maximum": 65535}
  },
  "$defs": {
    "addresses": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^([0-9.]+/32|[0-9a-fA-F:]+/128)$"}}
  }
}
