{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/policy-registry/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "modules",
    "investigationBudget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "policy-registry/v2"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,199}$"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          }
        }
      }
    },
    "investigationBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "rawQueries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "resultBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 41943040
        },
        "graphNodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "evidenceItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "modelRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "modelCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "allowedDataClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "D0",
              "D1"
            ]
          }
        }
      },
      "required": [
        "toolCalls",
        "rawQueries",
        "resultBytes",
        "graphNodes",
        "evidenceItems",
        "modelRequests",
        "inputTokens",
        "outputTokens",
        "modelCostMicros",
        "durationSeconds",
        "allowedDataClasses"
      ]
    }
  }
}
