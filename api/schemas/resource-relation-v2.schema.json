    },
    "ttl": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    }
  },
  "required": [
    "from",
    "to",
    "kind",
    "provenance",
    "confidence",
    "observedAt",
    "validFrom",
    "ttl"
