{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "from": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "to": {
      "$ref": "https://ops.local/schemas/common/v1#/$defs/canonicalId"
    },
    "kind": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
