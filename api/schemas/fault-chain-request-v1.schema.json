{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "fault-chain-request/v1",
        "fault-chain-request/v2"
      ]
    },
    "targetCanonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ]
    },
    "maxEdges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "readOnlyCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "originTurnId": {
          "type": "string",
          "format": "uuid"
        },
        "relationDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "gapCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonicalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tool": {
          "enum": [
            "get_resource_health",
            "get_dependencies",
            "execute_analysis_query"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "incoming",
            "outgoing",
            "either"
          ]
        }
      },
      "required": [
        "originTurnId",
        "gapCode",
        "canonicalId",
        "tool"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "targetCanonicalId",
    "fault",
    "maxEdges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/fault-chain-request/v1"
}
