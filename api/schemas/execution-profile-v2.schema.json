{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.local/schemas/execution-profile/v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executionProfileId": {
      "type": "string",
      "maxLength": 512
    },
    "clusterUid": {
      "type": "string",
      "maxLength": 512
    },
    "namespace": {
      "type": "string",
      "maxLength": 512
    },
    "name": {
      "type": "string",
      "maxLength": 512
    },
    "networkPolicyRef": {
      "type": "string",
      "maxLength": 512
    },
    "credentialRef": {
      "type": "string",
      "maxLength": 512
    },
    "principal": {
      "type": "string",
      "maxLength": 512
    },
    "hostOnboardingRef": {
      "type": "string",
      "maxLength": 512
    },
    "schemaVersion": {
      "const": "execution-profile/v2"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "k8s_namespace",
        "k8s_cluster",
        "ssh_user",
        "ssh_root"
      ]
    },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "toolImageDigest": {
      "type": "string",
      "pattern": "^.+@sha256:[0-9a-f]{64}$"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "developmentFallback": {
      "const": false
    }
  },
  "required": [
    "executionProfileId",
    "clusterUid",
    "namespace",
    "name",
    "networkPolicyRef",
    "credentialRef",
    "principal",
    "hostOnboardingRef",
    "schemaVersion",
    "version",
    "type",
    "allowedTargets",
    "tools",
    "toolImageDigest",
    "timeoutSeconds",
    "maxOutputBytes",
    "developmentFallback"
  ]
}
